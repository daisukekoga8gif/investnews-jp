# ============================================
# 投資ニュース集約サイト — 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# ============================================

# --------------------------------------------
# Supabase
# https://supabase.com/dashboard → Settings → API
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------
# Anthropic Claude API
# https://console.anthropic.com/ → API Keys
# --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# --------------------------------------------
# Vercel Cron シークレット
# ランダムな文字列を設定してください（例: openssl rand -hex 32）
# Vercel Dashboard → Settings → Environment Variables にも同じ値を設定
# --------------------------------------------
CRON_SECRET=your-random-secret-string-here

# --------------------------------------------
# 管理画面パスワード（シンプル認証用・将来的にSupabase Authに変更推奨）
# --------------------------------------------
ADMIN_PASSWORD=your-admin-password-here

# --------------------------------------------
# X (Twitter) API — 第2段階以降
# https://developer.twitter.com/
# --------------------------------------------
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_BEARER_TOKEN=

# --------------------------------------------
# サイト設定
# --------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=投資ニュース
